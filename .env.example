# 데이터베이스. 비우면 로컬 SQLite 파일(data/goods_trend.db).
# Supabase 를 쓰면 Session pooler 주소: postgresql://postgres.xxxx:비밀번호@aws-0-....pooler.supabase.com:5432/postgres
DATABASE_URL=
# 원본 페이지 보관: local(압축 저장, 기본) / off(저장 안 함)
RAW_STORE=
RAW_KEEP_DAYS=
# 복사해서 .env 로 저장하거나, 터미널에서 export 로 설정한다. 실제 키는 절대 커밋하지 말 것.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
YOUTUBE_API_KEY=
# 검색어(굿즈 종류). 비우면 processing/dictionaries.py 의 전체 종류
TRACK_KEYWORDS=
